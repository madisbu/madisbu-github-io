---
import HeroSentence from "../components/HeroSentence.astro";
import Layout from "../layouts/Layout.astro";

const pageDescription =
  "I build fast, focused web products — clean interfaces, minimal dependencies, and sharp attention to detail.";
const heroAlt = "Portrait of Madis";
---

<Layout description={pageDescription}>
  <section class="hero-section relative flex h-full min-h-0 flex-col">
    <div class="hero-copy pt-4 sm:pt-6 lg:pt-8">
      <HeroSentence />
    </div>

    <div class="hero-cta-mobile mt-auto grid -translate-y-2 grid-cols-2 gap-3 portrait:max-lg:hidden sm:gap-4 lg:hidden">
      <a
        href="/projects"
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-text-dark bg-body px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-text-dark shadow-sm transition-colors hover:bg-text-dark hover:text-body sm:min-h-12 sm:px-5 sm:text-sm"
      >
        VIEW PROJECTS
      </a>
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#EFF93B] px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-black shadow-sm transition-colors hover:bg-[#dbe52f] sm:min-h-12 sm:px-5 sm:text-sm"
      >
        LET&apos;S TALK
      </a>
    </div>

    <div class="hero-image-wrap relative mt-auto flex shrink-0 items-end justify-center">
      <picture class="hero-image-frame flex w-full items-end justify-center overflow-hidden lg:block lg:h-auto lg:max-w-[56rem] lg:overflow-visible">
        <source
          media="(orientation: landscape) and (min-width: 481px) and (max-width: 1023px) and (max-height: 480px)"
          type="image/avif"
          srcset="/images/hero-mobile-480.avif 480w, /images/hero-mobile-768.avif 768w"
          sizes="50vw"
        />
        <source
          media="(orientation: landscape) and (min-width: 481px) and (max-width: 1023px) and (max-height: 480px)"
          type="image/webp"
          srcset="/images/hero-mobile-480.webp 480w, /images/hero-mobile-768.webp 768w"
          sizes="50vw"
        />
        <source
          media="(max-width: 1366px) and (orientation: portrait)"
          type="image/avif"
          srcset="/images/hero-mobile-480.avif 480w, /images/hero-mobile-768.avif 768w"
          sizes="(max-width: 639px) 100vw, 64rem"
        />
        <source
          media="(max-width: 1366px) and (orientation: portrait)"
          type="image/webp"
          srcset="/images/hero-mobile-480.webp 480w, /images/hero-mobile-768.webp 768w"
          sizes="(max-width: 639px) 100vw, 64rem"
        />
        <source
          type="image/avif"
          srcset="/images/hero-480.avif 480w, /images/hero-768.avif 768w, /images/hero-1200.avif 1200w, /images/hero-1376.avif 1376w"
          sizes="(max-width: 639px) 100vw, (max-width: 1023px) 100vw, (min-width: 2560px) 86rem, (min-width: 1920px) 72rem, 64rem"
        />
        <source
          type="image/webp"
          srcset="/images/hero-480.webp 480w, /images/hero-768.webp 768w, /images/hero-1200.webp 1200w, /images/hero-1376.webp 1376w"
          sizes="(max-width: 639px) 100vw, (max-width: 1023px) 100vw, (min-width: 2560px) 86rem, (min-width: 1920px) 72rem, 64rem"
        />
        <img
          src="/images/hero-1200.webp"
          srcset="/images/hero-480.webp 480w, /images/hero-768.webp 768w, /images/hero-1200.webp 1200w, /images/hero-1376.webp 1376w"
          sizes="(max-width: 639px) 100vw, (max-width: 1023px) 100vw, (min-width: 2560px) 86rem, (min-width: 1920px) 72rem, 64rem"
          width="1200"
          height="670"
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mobile-hero-image h-full w-full max-w-full object-contain object-bottom lg:h-auto"
        />
      </picture>

      <div class="hero-cta-overlay pointer-events-none absolute inset-x-2 bottom-[5.75rem] hidden justify-between gap-2 sm:inset-x-4 sm:bottom-4 md:bottom-6 lg:flex lg:inset-x-0 lg:top-[58%] lg:bottom-auto lg:-translate-y-1/2 lg:px-2">
        <a
          href="/projects"
          class="hero-cta-button pointer-events-auto inline-flex min-h-11 w-[48%] max-w-[11rem] items-center justify-center rounded-md border border-text-dark bg-body/90 px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-text-dark shadow-sm backdrop-blur-sm transition-colors hover:bg-text-dark hover:text-body sm:min-h-12 sm:w-[44%] sm:px-5 sm:text-sm"
        >
          VIEW PROJECTS
        </a>
        <a
          href="/contact"
          class="hero-cta-button pointer-events-auto inline-flex min-h-11 w-[48%] max-w-[11rem] items-center justify-center rounded-md bg-[#EFF93B] px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-black shadow-sm transition-colors hover:bg-[#dbe52f] sm:min-h-12 sm:w-[44%] sm:px-5 sm:text-sm"
        >
          LET&apos;S TALK
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    min-height: 100%;
  }

  @media
    (orientation: landscape) and
    (min-width: 481px) and
    (max-width: 1023px) and
    (max-height: 480px) {
    .hero-section {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr);
      column-gap: 1rem;
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .hero-copy {
      display: flex;
      grid-column: 1;
      grid-row: 1;
      align-items: center;
      justify-content: center;
      min-width: 0;
      padding: 0;
      transform: none;
    }

    .hero-cta-mobile {
      display: none;
    }

    .hero-image-wrap {
      grid-column: 2;
      grid-row: 1;
      align-self: stretch;
      width: 100%;
      min-width: 0;
      min-height: 0;
      margin: 0;
      transform: none;
    }

    .hero-image-frame {
      display: flex;
      width: 100%;
      height: 100%;
      max-width: none;
      overflow: hidden;
    }

    .mobile-hero-image {
      width: 100%;
      height: 100%;
      max-width: 100%;
      object-fit: contain;
      object-position: center bottom;
      transform: none;
    }

    .hero-cta-overlay {
      display: none;
    }
  }

  @media (max-width: 1366px) and (orientation: portrait) {
    .hero-section {
      --hero-available-height: calc(
        var(--app-height, 100svh) - var(--header-height, 0px) -
          var(--site-footer-height, 0px) - var(--mobile-footer-height, 0px)
      );
    }

    .hero-image-frame {
      height: clamp(12rem, calc(var(--hero-available-height) - 16rem), 20rem);
    }
  }

  @media (min-width: 1366px) {
    .hero-image-frame {
      max-width: min(62rem, calc(76svh + 16rem));
    }
  }

  @media (min-width: 1440px) {
    .hero-section {
      min-height: calc(100svh - 9rem);
    }

    .hero-copy {
      transform: translateY(clamp(0rem, calc(90svh - 50.625rem), 32rem));
    }

    .hero-image-wrap {
      margin-bottom: -3rem;
      transform: translateY(calc(-6% - 18px));
    }
  }

  @media (min-width: 1366px) and (max-height: 800px) {
    .hero-section {
      min-height: 100%;
    }

    .hero-image-frame {
      max-width: 48rem;
    }

    .hero-image-wrap {
      margin-bottom: 0;
      transform: none;
    }
  }

  @media
    (min-width: 1366px) and (max-width: 1439px) and
    (min-height: 801px) {
    .hero-copy {
      transform: translateY(-2rem);
    }

    .hero-image-frame {
      max-width: 58.75rem;
    }
  }

  @media (min-width: 640px) and (max-width: 1366px) and (orientation: portrait) {
    .hero-copy {
      transform: translateY(clamp(0rem, calc(70svh - 44.8rem), 7rem));
    }

    .hero-image-wrap {
      margin-bottom: 0;
    }

    .hero-image-frame {
      display: flex;
      height: clamp(30rem, calc(var(--hero-available-height) - 10.75rem), 70rem);
      max-width: 100%;
      overflow: hidden;
    }

    .mobile-hero-image {
      height: 100%;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      transform: none;
      object-fit: contain;
      object-position: center bottom;
    }

    .hero-cta-overlay {
      display: none;
    }

  }

  @media (min-width: 1024px) and (max-width: 1366px) and (orientation: portrait) {
    .hero-image-frame {
      height: clamp(30rem, calc(var(--hero-available-height) - 12.55rem), 70rem);
    }
  }

  @media
    (min-width: 800px) and (max-width: 900px) and
    (min-height: 1100px) and (orientation: portrait),
    (min-width: 1000px) and (max-width: 1100px) and
    (min-height: 1300px) and (orientation: portrait) {
    .hero-copy {
      transform: translateY(4rem);
    }
  }

  @media
    (min-width: 1000px) and (max-width: 1100px) and
    (min-height: 1300px) and (orientation: portrait) {
    .hero-image-frame .mobile-hero-image {
      width: 94%;
      margin-inline: auto;
    }
  }

  @media (min-width: 1920px) and (min-height: 1000px) {
    .hero-copy {
      transform: translateY(clamp(2rem, 4svh, 4rem));
    }

    .hero-image-wrap {
      width: clamp(72rem, calc(211svh - 81.125rem), calc(100vw - 4rem));
      max-width: calc(100vw - 4rem);
      align-self: center;
      transform: translateY(-3rem);
    }

    .hero-image-frame {
      max-width: 100%;
    }

    .hero-cta-overlay {
      max-width: 64rem;
      margin-inline: auto;
    }
  }

  @media (min-width: 2560px) {
    .hero-cta-overlay {
      max-width: 80rem;
    }

    .hero-cta-button {
      min-height: 3.5rem;
      max-width: 13rem;
      font-size: 1rem;
    }
  }

  @media (min-width: 3840px) {
    .hero-cta-overlay {
      max-width: 112rem;
    }

    .hero-cta-button {
      min-height: 4rem;
      max-width: 16rem;
      font-size: 1.25rem;
    }
  }

  @media (min-width: 3840px) and (min-height: 2000px) {
    .hero-image-wrap {
      width: min(74vw, 178rem);
    }
  }

  @media (max-width: 389px) and (orientation: portrait) {
    .hero-image-frame {
      height: clamp(17rem, calc(var(--hero-available-height) - 10rem), 24rem);
    }

    .mobile-hero-image {
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      transform: none;
      object-fit: contain;
      object-position: center bottom;
    }
  }

  @media (min-width: 390px) and (max-width: 639px) and (orientation: portrait) {
    .hero-copy {
      margin-top: auto;
      padding-top: 0;
      transform: translateY(clamp(-5.5rem, -12vw, -4rem));
    }

    .hero-image-wrap {
      margin-top: clamp(0.875rem, 1.5vw, 1rem);
    }

    .hero-image-frame {
      height: clamp(18rem, calc(var(--hero-available-height) - 12rem), 28rem);
    }

    .mobile-hero-image {
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      transform: none;
      object-fit: contain;
      object-position: center bottom;
    }
  }
</style>
