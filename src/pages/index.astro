---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Project One",
    description: "A clean Astro build focused on performance and sharp UI details.",
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1200&auto=format&fit=crop&q=80",
    slug: "/projects/project-one",
  },
  {
    title: "Project Two",
    description: "A production-ready static site with minimal dependencies and fast load times.",
    image: "https://images.unsplash.com/photo-1518773553398-650c184e0bb3?w=1200&auto=format&fit=crop&q=80",
    slug: "/projects/project-two",
  },
  {
    title: "Project Three",
    description: "A portfolio experience built from Astroplate visuals, without Astroplate bloat.",
    image: "https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=1200&auto=format&fit=crop&q=80",
    slug: "/projects/project-three",
  },
];
---

<Layout>
  <section class="mb-14 max-w-2xl">
    <p class="mb-4 text-sm tracking-wide text-text-light">FREELANCE DEVELOPER</p>
    <h1 class="mb-4 text-4xl text-text-dark sm:text-5xl">Building clean and focused web experiences.</h1>
    <p class="text-text-light">
      This is a lean Astro setup that keeps Astroplate’s visual style while removing unnecessary logic and dependencies.
    </p>
  </section>

  <section id="projects">
    <h2 class="mb-6 text-2xl text-text-dark">Projects</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</Layout>
