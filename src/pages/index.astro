---
import HeroSentence from "../components/HeroSentence.astro";
import Layout from "../layouts/Layout.astro";

const pageDescription =
  "I build fast, focused web products — clean interfaces, minimal dependencies, and sharp attention to detail.";
const heroAlt = "Portrait of Madis";
---

<Layout description={pageDescription}>
  <section class="hero-section relative flex h-full min-h-0 flex-col">
    <div class="hero-copy pt-4 sm:pt-6 lg:pt-8">
      <HeroSentence />
    </div>

    <div class="hero-cta-mobile mt-auto grid -translate-y-2 grid-cols-2 gap-3 portrait:max-lg:hidden sm:gap-4 lg:hidden">
      <a
        href="/projects"
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-text-dark bg-body px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-text-dark shadow-sm transition-colors hover:bg-text-dark hover:text-body sm:min-h-12 sm:px-5 sm:text-sm"
      >
        VIEW PROJECTS
      </a>
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#EFF93B] px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-black shadow-sm transition-colors hover:bg-[#dbe52f] sm:min-h-12 sm:px-5 sm:text-sm"
      >
        LET&apos;S TALK
      </a>
    </div>

    <div class="hero-image-wrap relative mt-auto flex shrink-0 items-end justify-center lg:-mb-12">
      <picture class="hero-image-frame flex w-full items-end justify-center overflow-hidden lg:block lg:h-auto lg:max-w-[56rem] lg:overflow-visible">
        <source
          type="image/avif"
          srcset="/images/hero-480.avif 480w, /images/hero-768.avif 768w, /images/hero-1200.avif 1200w"
          sizes="(max-width: 639px) 100vw, (max-width: 1023px) 100vw, 64rem"
        />
        <source
          type="image/webp"
          srcset="/images/hero-480.webp 480w, /images/hero-768.webp 768w, /images/hero-1200.webp 1200w"
          sizes="(max-width: 639px) 100vw, (max-width: 1023px) 100vw, 64rem"
        />
        <img
          src="/images/hero-1200.webp"
          srcset="/images/hero-480.webp 480w, /images/hero-768.webp 768w, /images/hero-1200.webp 1200w"
          sizes="(max-width: 639px) 100vw, (max-width: 1023px) 100vw, 64rem"
          width="1200"
          height="670"
          alt={heroAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mobile-hero-image h-full w-auto max-w-none object-contain object-bottom lg:h-auto lg:w-full lg:max-w-full"
        />
      </picture>

      <div class="hero-cta-overlay pointer-events-none absolute inset-x-2 bottom-[5.75rem] hidden justify-between gap-2 sm:inset-x-4 sm:bottom-4 md:bottom-6 lg:flex lg:inset-x-0 lg:top-[58%] lg:bottom-auto lg:-translate-y-1/2 lg:px-2">
        <a
          href="/projects"
          class="pointer-events-auto inline-flex min-h-11 w-[48%] max-w-[11rem] items-center justify-center rounded-md border border-text-dark bg-body/90 px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-text-dark shadow-sm backdrop-blur-sm transition-colors hover:bg-text-dark hover:text-body sm:min-h-12 sm:w-[44%] sm:px-5 sm:text-sm"
        >
          VIEW PROJECTS
        </a>
        <a
          href="/contact"
          class="pointer-events-auto inline-flex min-h-11 w-[48%] max-w-[11rem] items-center justify-center rounded-md bg-[#EFF93B] px-3 py-3 text-center text-[0.7rem] font-bold tracking-wide text-black shadow-sm transition-colors hover:bg-[#dbe52f] sm:min-h-12 sm:w-[44%] sm:px-5 sm:text-sm"
        >
          LET&apos;S TALK
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    --hero-mobile-image-scale: 1;
    --hero-tablet-image-scale: 1;
    min-height: 100%;
  }

  @media (max-width: 1366px) and (orientation: portrait) {
    .hero-section {
      --hero-available-height: calc(
        var(--app-height, 100svh) - var(--header-height, 0px) - var(--mobile-footer-height, 0px)
      );
    }

    .hero-image-frame {
      height: clamp(12rem, calc(var(--hero-available-height) - 16rem), 20rem);
    }
  }

  @media (min-width: 1367px) {
    .hero-section {
      min-height: calc(100svh - 9rem);
    }

    .hero-image-wrap {
      transform: translateY(calc(-6% - 18px));
    }
  }

  @media (min-width: 640px) and (max-width: 1366px) and (orientation: portrait) {
    .hero-section {
      --hero-tablet-image-scale: 1.05;
    }

    .hero-copy {
      transform: translateY(clamp(4.5rem, 10vw, 8rem));
    }

    .hero-image-wrap {
      margin-bottom: 0;
    }

    .hero-image-frame {
      display: flex;
      height: clamp(18rem, calc(var(--hero-available-height) - 12rem), 40rem);
      max-width: 100%;
      overflow: hidden;
    }

    .mobile-hero-image {
      height: 100%;
      width: auto;
      max-width: none;
      margin-inline: auto;
      transform-origin: center bottom;
      transform: scale(var(--hero-tablet-image-scale));
    }

    .hero-cta-overlay {
      display: none;
    }

  }

  @media (max-width: 389px) and (orientation: portrait) {
    .hero-image-frame {
      height: clamp(17rem, calc(var(--hero-available-height) - 10rem), 24rem);
    }

    .mobile-hero-image {
      width: auto;
      margin-inline: auto;
      transform-origin: center bottom;
      transform: none;
    }
  }

  @media (min-width: 340px) and (max-width: 359px) and (orientation: portrait) {
    .mobile-hero-image {
      transform: scale(0.96);
    }
  }

  @media (min-width: 390px) and (max-width: 639px) and (orientation: portrait) {
    .hero-copy {
      margin-top: auto;
      padding-top: 0;
      transform: translateY(clamp(-5.5rem, -12vw, -4rem));
    }

    .hero-section {
      --hero-mobile-image-scale: 1.03;
    }

    .hero-image-wrap {
      margin-top: clamp(0.875rem, 1.5vw, 1rem);
    }

    .hero-image-frame {
      height: clamp(18rem, calc(var(--hero-available-height) - 12rem), 28rem);
    }

    .mobile-hero-image {
      width: auto;
      margin-inline: auto;
      transform-origin: center bottom;
      transform: scale(var(--hero-mobile-image-scale));
    }
  }
</style>
