---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — YourName">
  <section class="max-w-2xl">
    <h1 class="mb-4 text-4xl text-text-dark">About</h1>
    <p class="mb-4 text-text-light">
      I build fast, minimal websites with strong visual design and maintainable code.
    </p>
    <p class="text-text-light">
      This site keeps the Astroplate look while intentionally removing feature bloat like complex content routing,
      search indexing, and heavy dynamic integrations.
    </p>
  </section>
</Layout>
