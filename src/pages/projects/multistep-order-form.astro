---
import CaseStudyPage from "../../components/CaseStudyPage.astro";
import type { ProjectCaseStudy } from "../../types/case-study";

const project = {
  title: "Multistep Order Form",
  description:
    "An MVP web application that turns a detailed order into a manageable sequence of decisions.",
  discipline: "product-development",
  previousProject: {
    label: "Waste Disposal Website",
    href: "/projects/waste-disposal-website",
  },
  nextProject: {
    label: "Car Rental App Redesign",
    href: "/projects/car-rental-app-redesign",
  },
  cover: {
    src: "/images/projects/multistep-order-form/cover.webp",
    alt: "Multistep order form with contact fields, a pinned map location, and a continue action",
    width: 1200,
    height: 900,
    caption: "MVP order experience combining customer details and location confirmation.",
  },
  metadata: [
    { label: "Product stage", value: "Minimum viable product" },
    { label: "Role", value: "Product designer and developer" },
    { label: "Platform", value: "Responsive web application" },
    { label: "Core flow", value: "Multi-step order submission" },
  ],
  sections: [
    {
      id: "overview",
      title: "Overview",
      eyebrow: "Product context",
      summary: "Turn a long, error-prone order into a guided product experience.",
      paragraphs: [
        "Long order forms make it difficult to understand what information is needed and how much work remains. This product concept breaks the process into focused steps with a clear sense of progress.",
        "The MVP prioritizes the core purchase journey and creates a foundation that can be validated before investing in broader account, administration, and automation features.",
      ],
      metrics: [
        { value: "MVP", label: "Focused first release" },
        { value: "3 steps", label: "Progressive order journey" },
        { value: "Web app", label: "Responsive product interface" },
        { value: "1 goal", label: "Complete a valid order" },
      ],
    },
    {
      id: "opportunity",
      title: "Problem",
      eyebrow: "Discover",
      summary: "Customers need guidance; the business needs complete, structured order data.",
      paragraphs: [
        "A single large form exposes every field at once, mixes unrelated decisions, and often reports errors only after submission. This increases cognitive load and makes abandonment or incomplete data more likely.",
      ],
      callout: {
        label: "Product opportunity",
        text: "Create a flow that feels shorter to customers while improving the completeness and usability of submitted order data.",
      },
    },
    {
      id: "approach",
      title: "Product Approach",
      eyebrow: "Define and prioritize",
      summary: "Define the smallest valuable release, then make decisions that keep the order journey understandable and recoverable.",
      paragraphs: [
        "The MVP focuses on one measurable outcome: helping customers submit a complete order while giving the business structured data that can support later automation.",
      ],
      steps: [
        {
          title: "Must have",
          description: "Order type, customer details, location, contextual validation, review, and confirmation.",
        },
        {
          title: "Should have",
          description: "Saved progress during the session, clear error recovery, and responsive behavior.",
        },
        {
          title: "Later",
          description: "Accounts, saved addresses, order history, administration, notifications, and integrations.",
        },
      ],
      bullets: [
        "Use progressive disclosure so each step asks only questions relevant to the current decision.",
        "Preserve entered values when moving backward or correcting an error.",
        "Show progress with meaningful step names rather than percentage alone.",
        "Keep a single primary action and make backward navigation predictable.",
        "Treat location confirmation as a visual check, not only a text field.",
      ],
      callout: {
        label: "Key trade-off",
        text: "More steps can feel longer, but focused steps improve comprehension when each one has a clear purpose.",
      },
    },
    {
      id: "flow",
      title: "Multistep Order Form Flow",
      eyebrow: "Experience",
      summary: "Keep the mental model stable while the form progressively reveals detail.",
      steps: [
        {
          title: "Configure order",
          description: "Select the order type and provide details that determine later questions.",
        },
        {
          title: "Contact and location",
          description: "Enter standard contact fields and confirm the service location on a map.",
        },
        {
          title: "Review and submit",
          description: "Verify all selections, correct errors in context, and submit a complete order.",
        },
      ],
    },
    {
      id: "delivery",
      title: "Technical Delivery",
      eyebrow: "Build",
      summary: "Connect product decisions to architecture, data, quality, and maintainability.",
      paragraphs: [
        "The frontend is a Vue 3 single-page application built with Vite, using Pinia to hold order state across the three steps and Vue Router for navigation. Vue-i18n adds Estonian and Russian locales with a persisted language toggle, since the audience needed the form in their own language rather than English only.",
        "The backend is a Node.js and Express API that stores completed orders in Firestore through the Firebase Admin SDK and sends confirmation and admin notification emails through NodeMailer. Winston with Google Cloud Logging keeps a structured trail of requests, errors, and submission outcomes in production.",
      ],
    },
    {
      id: "outcome",
      title: "Outcome & Reflections",
      eyebrow: "Measure and learn",
      summary: "Separate what has been built from what still needs to be validated.",
      paragraphs: [
        "The MVP establishes a working foundation for a clearer order journey, but its strongest product claims still need evidence from real customers and submitted orders.",
      ],
      bullets: [
        "Measure completion rate, abandonment by step, errors per step, and time to complete.",
        "Compare the percentage of submissions that require manual clarification.",
        "Use usability testing and production feedback to identify confusing steps.",
        "Prioritize accounts, saved addresses, notifications, and integrations only after observing a validated need.",
      ],
    },
  ],
} satisfies ProjectCaseStudy;
---

<CaseStudyPage project={project} />
