---
import CaseStudyPage from "../../components/CaseStudyPage.astro";
import type { ProjectCaseStudy } from "../../types/case-study";

const project = {
  title: "Waste Disposal Website",
  description:
    "A clear service website and custom order form designed to simplify waste collection requests.",
  discipline: "web-design",
  previousProject: {
    label: "Car Rental App Redesign",
    href: "/projects/car-rental-app-redesign",
  },
  nextProject: {
    label: "Multistep Order Form",
    href: "/projects/multistep-order-form",
  },
  cover: {
    src: "/images/projects/waste-disposal-website/cover.webp",
    alt: "PrahiVeod waste disposal website shown across desktop and mobile screens",
    width: 1200,
    height: 748,
    caption: "Responsive service website and guided order form across desktop and mobile.",
  },
  metadata: [
    { label: "My Role", value: "Web Designer" },
    { label: "Platforms", value: "HTML/CSS · Vue.js · Wix" },
    { label: "Deliverables", value: "Web Design, Order Form, Migration" },
    { label: "Tools", value: "Figma · Miro · Google Analytics" },
  ],
  sections: [
    {
      id: "overview",
      title: "Overview",
      eyebrow: "Business context",
      summary: "Make a detailed operational service easy to understand and easy to order.",
      paragraphs: [
        "Waste collection involves details that can quickly overwhelm a customer: material type, volume, location, timing, and access requirements. This project organizes those decisions into a straightforward website and guided order request flow, giving customers a clearer path from exploring the service to submitting the details the business needs.",
        "Clear language and strong visual hierarchy make the service easier to understand while creating a more reliable alternative to phone-only ordering.",
      ],
      metrics: [
        { value: "2 formats", label: "Desktop and mobile experiences" },
        { value: "1 flow", label: "Guided waste collection request" },
        { value: "6 services", label: "Scannable service categories" },
        { value: "Responsive", label: "Designed across key breakpoints" },
      ],
    },
    {
      id: "problem",
      title: "Problem",
      eyebrow: "Strategy",
      summary: "Connect customer tasks with the information the business needs to fulfill an order.",
      paragraphs: [
        "The primary goal was to establish an online presence where none existed before, while making the ordering process more efficient. Previously, customers placed orders by phone, and many were unable to reach a company representative. Without an alternative way to submit a request, potential orders were missed. Four key problem areas emerged from this context:",
      ],
      numberedItems: [
        { text: "The company had no online presence, so few people in its service area knew it existed." },
        { text: "The available services and pricing were difficult to discover, leaving customers without clear information before ordering." },
        { text: "The business lacked a consistent brand identity and social media presence, making it harder to build recognition and trust." },
        { text: "Orders depended entirely on phone calls, so customers had no alternative way to submit a request when representatives were unavailable." },
      ],
      media: {
        src: "/images/projects/waste-disposal-website/focus-areas-waste.webp",
        alt: "Waste disposal website shown on two mobile screens",
        width: 600,
        height: 695,
        transparentBackground: true,
      },
    },
    {
      id: "process",
      title: "Workflow",
      eyebrow: "Challenge",
      summary: "Translate the brief into a clear set of design, content, branding, and delivery priorities.",
      steps: [
        {
          title: "Scoping & Design",
          description: "Project scope",
          tag: "Build • Phase 1",
          details: [
            "Project scoping",
            "Sitemap creation",
            "Figma sketches",
            "Client alignments",
          ],
        },
        {
          title: "Web Content",
          description: "Content assets",
          tag: "Build • Phase 1",
          details: [
            "Text and assets",
            "Add images",
            "Testing",
          ],
        },
        {
          title: "Branding & SEO",
          description: "Search visibility",
          tag: "Build • Phase 1",
          details: [
            "SEO setup",
            "Page optimization",
          ],
        },
        {
          title: "Custom Order Form",
          description: "Custom Vue.js form",
          tag: "Build • Phase 2",
          details: [
            "Order flow architecture",
            "Vue.js development",
            "Order validation",
          ],
        },
        {
          title: "Wix Platform",
