          tag: "Migration • Phase 3",
          details: [
            "Wix platform migration",
            "Page recreation",
            "Flow reconfiguration",
            "Functionality matching",
            "Client handover",
          ],
        },
      ],
    },
    {
      id: "sitemap",
      title: "Sitemap",
      eyebrow: "Interface design",
      summary: "Use the company’s industrial character without sacrificing clarity or accessibility.",
      sitemap: {
        root: {
          label: "Main",
          children: [
