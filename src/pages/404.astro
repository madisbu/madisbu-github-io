---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="This page could not be found. Explore Madis Burmeister's projects or return to the home page."
  noindex
>
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="error-code">404</p>
    <h1 id="not-found-heading">Looks like a wrong turn.</h1>
    <p class="error-message">This page may have moved, or the address may be incorrect. Let's get you back on track.</p>
    <nav aria-label="Page not found navigation">
      <a class="home-link" href="/">Back to home</a>
      <a href="/projects">Explore projects <span aria-hidden="true">&rarr;</span></a>
    </nav>
  </section>
</Layout>

<style>
  .not-found {
    max-width: 38rem;
    margin: clamp(1rem, 7vh, 5rem) auto;
    text-align: center;
  }

  .error-code {
    margin: 0 0 1rem;
    color: var(--color-text-dark);
    font-family: var(--font-secondary);
    font-size: clamp(5rem, 20vw, 9rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: underline #eff93b;
    text-underline-offset: 0.1em;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .error-message {
    margin: 1.5rem 0 2rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  nav a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-text-dark);
    border-radius: 0.375rem;
    color: var(--color-text-dark);
    font-weight: 700;
  }

  .home-link,
  nav a:hover {
    background: #eff93b;
  }
</style>
