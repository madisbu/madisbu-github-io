---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Car Rental App Redesign",
    description: "A friendlier mobile booking experience shaped around clarity, confidence, and fewer steps.",
    category: "UX/UI Design",
    filterKey: "ux-ui",
    image: "/images/projects/car-rental-app-redesign/cover.webp",
    slug: "/projects/car-rental-app-redesign",
  },
  {
    title: "Waste Disposal Website",
    description: "A focused service website with a custom order form that makes a complex request feel simple.",
    category: "Web Design",
    filterKey: "web",
    image: "/images/projects/waste-disposal-website/cover.webp",
    slug: "/projects/waste-disposal-website",
  },
  {
    title: "Multistep Order Form",
    description: "An MVP order flow that guides customers through a structured purchase without unnecessary friction.",
    category: "Product Development",
    filterKey: "product",
    image: "/images/projects/multistep-order-form/cover.webp",
    slug: "/projects/multistep-order-form",
  },
];

const filters = [
  { key: "all", label: "ALL WORK" },
  { key: "ux-ui", label: "UX/UI" },
  { key: "web", label: "WEB" },
  { key: "product", label: "PRODUCT" },
];

const pageDescription = "UX/UI, web design, and product development projects by Madis Burmeister.";
---

<Layout title="Projects" description={pageDescription} wide>
  <section class="projects-intro">
    <h1>Projects<span aria-hidden="true">.</span></h1>
  </section>

  <section class="projects-section" aria-label="Portfolio projects">
    <div class="projects-toolbar">
      <div class="projects-filters" aria-label="Project categories">
        {
          filters.map((filter, index) => (
            <button
              type="button"
              class="projects-filter"
              data-project-filter={filter.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => <ProjectCard {...project} index={index} />)}
    </div>
  </section>
</Layout>

<script>
  const initializeProjectFilters = () => {
    const section = document.querySelector<HTMLElement>(".projects-section");
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-project-card]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!section || section.dataset.filtersInitialized || !filters.length || !cards.length) return;
    section.dataset.filtersInitialized = "true";

    const revealCards = () => {
      if (reducedMotion || typeof IntersectionObserver === "undefined") {
        cards.forEach((card) => card.classList.add("is-visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.15 },
      );

      cards.forEach((card) => {
        card.classList.add("is-reveal-pending");
        observer.observe(card);
      });
    };

    const setFilter = (activeFilter: string) => {
      let visibleCount = 0;

      filters.forEach((filter) => {
        filter.setAttribute("aria-pressed", String(filter.dataset.projectFilter === activeFilter));
      });

      cards.forEach((card) => {
        card.getAnimations().forEach((animation) => animation.cancel());
        const matches = activeFilter === "all" || card.dataset.filterKey === activeFilter;
        card.hidden = !matches;

        if (!matches) return;

        visibleCount += 1;
        card.classList.add("is-visible");

        if (!reducedMotion) {
          card.animate(
            [
              { opacity: 0, transform: "translateY(12px) scale(0.985)" },
              { opacity: 1, transform: "translateY(0) scale(1)" },
            ],
            {
              duration: 360,
              delay: (visibleCount - 1) * 70,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              fill: "both",
            },
          );
        }
      });
    };

    filters.forEach((filter) => {
      filter.addEventListener("click", () => setFilter(filter.dataset.projectFilter ?? "all"));
    });

    revealCards();
  };

  document.addEventListener("astro:page-load", initializeProjectFilters);
  initializeProjectFilters();
</script>

<style>
  .projects-intro {
    padding: 1rem 0 clamp(2rem, 4vw, 3.5rem);
  }

  .projects-intro h1 {
    font-size: clamp(1.875rem, 8vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .projects-intro h1 span {
    color: #eff93b;
  }

  .projects-section {
    padding-bottom: clamp(5rem, 8vw, 7rem);
  }

  .projects-toolbar {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2.75rem, 5vw, 4rem);
  }

  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .projects-filter {
    min-height: 2.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-body);
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .projects-filter:hover {
    border-color: var(--color-text-dark);
  }

  .projects-filter[aria-pressed="true"] {
    border-color: var(--color-text-dark);
    background: var(--color-text-dark);
    color: var(--color-body);
  }

  .projects-filter:focus-visible {
    outline: 3px solid #eff93b;
    outline-offset: 2px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .projects-grid > [hidden] {
    display: none;
  }

  @media (min-width: 390px) and (max-width: 639px) and (orientation: portrait) {
    .projects-intro h1 {
      font-size: clamp(2.0625rem, calc(10vw - 0.375rem), 2.3125rem);
    }
  }

  @media (min-width: 640px) {
    .projects-intro h1 {
      font-size: 2.5rem;
    }

    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .projects-intro h1 {
      font-size: 3rem;
    }
  }

  @media (min-width: 1280px) {
    .projects-intro h1 {
      font-size: 3.75rem;
    }
  }

  @media
    (orientation: landscape) and
    (min-width: 481px) and
    (max-width: 1023px) and
    (max-height: 480px) {
    .projects-intro h1 {
      font-size: clamp(1.125rem, 3.6vw, 2rem);
    }
  }

  @media
    (orientation: landscape) and
    (min-width: 768px) and
    (max-width: 1366px) and
    (min-height: 481px) {
    .projects-intro h1 {
      font-size: clamp(2.5rem, 3.5vw, 3rem);
    }
  }

  @media (min-width: 2560px) {
    .projects-intro h1 {
      font-size: 4.5rem;
    }
  }

  @media (min-width: 3840px) {
    .projects-intro h1 {
      font-size: 6rem;
    }
  }

  @media (min-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-filter {
      transition: none;
    }
  }
</style>
