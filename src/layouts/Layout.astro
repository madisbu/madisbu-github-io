---
import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const siteName = "Mabux";
const baseUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://www.mabux.me";

const {
  title = siteName,
  description = "Personal site built with a lean Astroplate-inspired design.",
  ogImage,
  canonicalUrl,
} = Astro.props;

const resolvedTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const resolvedCanonicalUrl = canonicalUrl ?? new URL(Astro.url.pathname, baseUrl).toString();
const resolvedOgImage = ogImage ? new URL(ogImage, baseUrl).toString() : undefined;
const isHomePage = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;600&family=Signika:wght@500;700&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
  </head>
  <body
    class:list={[
      "flex min-h-screen flex-col",
      isHomePage && "home-page overflow-hidden lg:overflow-visible",
    ]}
  >
    <Header />
    <main
      class:list={[
        "mx-auto w-full max-w-5xl grow px-4 pt-12 pb-24 sm:py-12",
        isHomePage && "home-main flex min-h-0 flex-col overflow-hidden pb-[4.25rem] sm:pb-0 lg:block lg:overflow-visible lg:pb-0",
      ]}
    >
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>

<style is:global>
  :root {
    --app-height: 100svh;
    --header-height: 0px;
    --mobile-footer-height: 68px;
    --site-footer-height: 0px;
  }

  /* General portrait rule — applies to all portrait screens up to 1023px. */
  @media (max-width: 1023px) and (orientation: portrait) {
    body.home-page {
      min-height: var(--app-height);
      height: var(--app-height);
    }

    body.home-page main.home-main {
      min-height: calc(
        var(--app-height) - var(--header-height) - var(--site-footer-height)
      );
      padding-bottom: var(--mobile-footer-height);
    }
  }

  /*
   * Tablet portrait override — intentionally follows the general portrait rule above.
   * Resets padding-bottom (overlay CTAs are used instead of the mobile footer bar)
   * and enables flex layout for the main content area.
   * The 640–1023px range is covered by both blocks; the later rule wins.
   */
  @media (min-width: 640px) and (max-width: 1366px) and (orientation: portrait) {
    body.home-page {
      height: var(--app-height);
      overflow: hidden;
    }

    body.home-page main.home-main {
      display: flex;
      min-height: calc(
        var(--app-height) - var(--header-height) - var(--site-footer-height)
      );
      overflow: hidden;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1367px), (min-width: 1024px) and (orientation: landscape) {
    body.home-page {
      height: auto;
      min-height: 100vh;
    }

    body.home-page main.home-main {
      min-height: 0;
      padding-bottom: 0;
    }
  }
</style>

<script>
  type ViewportSyncWindow = Window & typeof globalThis & {
    __mabuxViewportCleanup?: () => void;
  };

  const viewportWindow = window as ViewportSyncWindow;

  const syncHomeViewport = () => {
    const root = document.documentElement;
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const footer = document.querySelector<HTMLElement>("[data-site-footer]");
    const mobileQuickLinks = document.querySelector<HTMLElement>("[data-mobile-quick-links]");

    const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
    const headerHeight = header?.getBoundingClientRect().height ?? 0;
    const siteFooterHeight = footer?.getBoundingClientRect().height ?? 0;
    const mobileFooterHeight =
      mobileQuickLinks && getComputedStyle(mobileQuickLinks).display !== "none"
        ? mobileQuickLinks.getBoundingClientRect().height
        : 0;

    root.style.setProperty("--app-height", `${viewportHeight}px`);
    root.style.setProperty("--header-height", `${headerHeight}px`);
    root.style.setProperty("--site-footer-height", `${siteFooterHeight}px`);
    root.style.setProperty("--mobile-footer-height", `${mobileFooterHeight}px`);
  };

  const initializeHomeViewportSync = () => {
    viewportWindow.__mabuxViewportCleanup?.();

    const observedElements = [
      document.querySelector<HTMLElement>("[data-site-header]"),
      document.querySelector<HTMLElement>("[data-site-footer]"),
      document.querySelector<HTMLElement>("[data-mobile-quick-links]"),
    ].filter((element): element is HTMLElement => element !== null);

    const onResize = syncHomeViewport;
    const resizeObserver =
      typeof ResizeObserver === "function" ? new ResizeObserver(onResize) : undefined;

    observedElements.forEach((element) => resizeObserver?.observe(element));

    // Prefer visualViewport resize (accurate on mobile, e.g. virtual keyboard).
    // Fall back to window resize only when visualViewport is unavailable.
    if (window.visualViewport) {
      window.visualViewport.addEventListener("resize", onResize);
      window.visualViewport.addEventListener("scroll", onResize);
    } else {
      window.addEventListener("resize", onResize);
    }
    window.addEventListener("orientationchange", onResize);

    syncHomeViewport();

    viewportWindow.__mabuxViewportCleanup = () => {
      if (window.visualViewport) {
        window.visualViewport.removeEventListener("resize", onResize);
        window.visualViewport.removeEventListener("scroll", onResize);
      } else {
        window.removeEventListener("resize", onResize);
      }
      window.removeEventListener("orientationchange", onResize);
      resizeObserver?.disconnect();
    };

    // Re-register cleanup on every init so SPA navigations are always covered.
    document.addEventListener("astro:before-swap", () => {
      viewportWindow.__mabuxViewportCleanup?.();
    }, { once: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeHomeViewportSync, { once: true });
  } else {
    initializeHomeViewportSync();
  }

  // Re-initialize after each Astro view transition.
  document.addEventListener("astro:after-swap", initializeHomeViewportSync);
</script>
