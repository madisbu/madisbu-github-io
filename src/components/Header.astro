---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Resume", href: "/resume" },
  { label: "Contact", href: "/contact" },
];

const githubUrl = "https://github.com/madisbu";

const { pathname } = Astro.url;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};
---

<header data-site-header class="border-b border-border bg-body">
  <div class="header-shell relative mx-auto flex w-full max-w-5xl items-center px-4 py-3 sm:py-4">
    <!-- Logo -->
    <a href="/" class="inline-flex shrink-0 items-center" aria-label="Mabux Home">
      <picture>
        <source srcset="/mabux_logo_transparent.webp" type="image/webp" />
        <img src="/mabux_logo.png" alt="Mabux" width="80" height="80" class="brand-logo h-20 w-auto sm:h-20" loading="eager" decoding="async" />
      </picture>
    </a>

    <!-- Desktop: centered nav -->
    <nav aria-label="Main navigation" class="desktop-nav absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-7 text-sm font-bold tracking-widest uppercase sm:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded px-3 py-1.5 transition-colors",
              isActive(item.href)
                ? "bg-[#EFF93B] text-black"
                : "text-text-dark hover:text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right side -->
    <div class="ml-auto flex items-center gap-3">
      <!-- Desktop: GitHub button -->
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="desktop-github hidden items-center gap-2 rounded-sm border border-text-light px-4 py-1.5 text-sm font-bold tracking-wide text-text-dark transition-colors hover:bg-text-dark hover:text-body sm:inline-flex"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52 0-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
        GitHub
      </a>

      <!-- Mobile: hamburger button -->
      <button
        id="mobile-menu-open"
        type="button"
        class="mobile-menu-toggle min-h-11 min-w-11 p-2 text-text-dark sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu-overlay"
      >
        <svg class="h-6 w-6 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/>
        </svg>
      </button>
    </div>
  </div>
  <noscript>
    <nav class="mobile-fallback-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </noscript>
</header>

<!-- Mobile: full-screen overlay menu -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-50 hidden flex-col bg-body"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-menu-title"
  aria-hidden="true"
>
  <!-- Close button -->
  <button
    id="mobile-menu-close"
    type="button"
    class="absolute right-5 top-5 text-2xl font-light text-text-dark"
    aria-label="Close menu"
  >
    ✕
  </button>

  <!-- Nav items -->
  <nav aria-label="Main navigation" class="flex flex-1 flex-col items-center justify-center gap-4">
    <p id="mobile-menu-title" class="mb-6 text-xl font-black tracking-widest uppercase text-text-dark">Menu</p>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "w-64 rounded px-6 py-3 text-center text-sm font-bold tracking-widest uppercase transition-colors",
            isActive(item.href)
              ? "bg-[#EFF93B] text-black"
              : "text-text-dark hover:bg-light",
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-64 rounded px-6 py-3 text-center text-sm font-bold tracking-widest uppercase transition-colors text-text-dark hover:bg-light inline-flex items-center justify-center gap-2"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      GITHUB
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 opacity-60" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </nav>
</div>

<style>
  [data-site-header] {
    padding-top: env(safe-area-inset-top, 0px);
  }

  .header-shell {
    padding-left: max(1rem, env(safe-area-inset-left, 0px));
    padding-right: max(1rem, env(safe-area-inset-right, 0px));
  }

  #mobile-menu-overlay {
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  #mobile-menu-overlay nav {
    min-height: 100%;
    flex-shrink: 0;
    padding: 4rem 1rem 2rem;
    justify-content: safe center;
  }

  #mobile-menu-close {
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    top: max(1.25rem, env(safe-area-inset-top, 0px));
    right: max(1.25rem, env(safe-area-inset-right, 0px));
  }

  #mobile-menu-overlay nav > a {
    min-height: 2.75rem;
  }

  .mobile-fallback-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1rem 1rem;
    font-weight: 700;
  }

  .mobile-fallback-nav a {
    padding: 0.5rem;
  }

  @media (min-width: 768px) {
    .mobile-fallback-nav {
      display: none;
    }
  }

  @media (min-width: 640px) and (max-width: 767px) {
    .desktop-nav,
    .desktop-github {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }
  }

  @media (min-width: 640px) and (max-width: 820px) {
    .brand-logo {
      height: 4.25rem;
    }

    .desktop-nav {
      gap: 1.6rem;
      font-size: 0.8125rem;
    }

    .desktop-nav a {
      padding-left: 0.6rem;
      padding-right: 0.6rem;
    }

    .desktop-github {
      gap: 0.45rem;
      padding-left: 0.7rem;
      padding-right: 0.7rem;
      font-size: 0.8125rem;
    }
  }

  @media
    (orientation: landscape) and
    (min-width: 481px) and
    (max-width: 1023px) and
    (max-height: 480px) {
    .desktop-nav,
    .desktop-github {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }

    .mobile-fallback-nav {
      display: flex;
    }
  }

  @media
    (orientation: landscape) and
    (min-width: 481px) and
    (max-width: 1023px) and
    (max-height: 480px) {
    .header-shell {
      padding-block: 0.25rem;
    }

    .brand-logo {
      height: 3rem;
    }

    .mobile-menu-toggle {
      padding: 0.375rem;
    }

    #mobile-menu-close {
      top: max(0.75rem, env(safe-area-inset-top, 0px));
      right: max(1rem, env(safe-area-inset-right, 0px));
    }

    #mobile-menu-overlay nav {
      gap: 0.75rem;
      padding: 2.5rem 1rem 0.75rem;
      overflow-y: auto;
    }

    #mobile-menu-title {
      margin-bottom: 0.75rem;
      font-size: 1rem;
      line-height: 1.25;
    }

    #mobile-menu-overlay nav > a {
      padding-block: 0.5rem;
      font-size: 0.75rem;
      line-height: 1.25;
    }
  }

  @media (min-width: 2560px) {
    .header-shell {
      max-width: 80rem;
      padding-block: 1.25rem;
    }

    .brand-logo {
      height: 6rem;
    }

    .desktop-nav {
      gap: 2.25rem;
      font-size: 1rem;
    }

    .desktop-github {
      padding: 0.625rem 1.25rem;
      font-size: 1rem;
    }
  }

  @media (min-width: 3840px) {
    .header-shell {
      max-width: 112rem;
      padding-block: 1.5rem;
    }

    .brand-logo {
      height: 8rem;
    }

    .desktop-nav {
      gap: 3rem;
      font-size: 1.25rem;
    }

    .desktop-github {
      padding: 0.75rem 1.5rem;
      font-size: 1.25rem;
    }
  }

  @media (scripting: none) {
    .mobile-menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>("#mobile-menu-open");
  const closeBtn = document.querySelector<HTMLButtonElement>("#mobile-menu-close");
  const overlay = document.querySelector<HTMLElement>("#mobile-menu-overlay")!;

  const focusableSelectors = 'a[href], button:not([disabled])';
  let previousOverflow = "";
  let backgroundElements: { element: HTMLElement; wasInert: boolean }[] = [];

  const openMenu = () => {
    previousOverflow = document.body.style.overflow;
    backgroundElements = Array.from(document.querySelectorAll<HTMLElement>(
      "[data-site-header], main, [data-site-footer], #back-to-top, .skip-link",
    )).map((element) => ({ element, wasInert: element.inert }));
    backgroundElements.forEach(({ element }) => { element.inert = true; });
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    openBtn?.setAttribute("aria-expanded", "true");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    // Move focus to the close button when overlay opens
    closeBtn?.focus();
  };

  const closeMenu = () => {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    openBtn?.setAttribute("aria-expanded", "false");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = previousOverflow;
    backgroundElements.forEach(({ element, wasInert }) => { element.inert = wasInert; });
    backgroundElements = [];
    // Return focus to the hamburger button
    if (openBtn?.getClientRects().length) openBtn.focus();
    else document.querySelector<HTMLElement>(".desktop-nav [aria-current], [data-site-header] a")?.focus();
  };

  const closeOnDesktop = () => {
    if (!overlay.classList.contains("hidden") && !openBtn?.getClientRects().length) closeMenu();
  };

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  window.addEventListener("resize", closeOnDesktop);

  overlay?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Close on Escape key — named handler so it can be removed
  const onKeyDown = (e: KeyboardEvent) => {
    if (e.key === "Escape" && !overlay.classList.contains("hidden")) {
      closeMenu();
    }
  };

  document.addEventListener("keydown", onKeyDown);

  // Clean up before Astro View Transitions swap to avoid stacking listeners
  document.addEventListener("astro:before-swap", () => {
    document.removeEventListener("keydown", onKeyDown);
    window.removeEventListener("resize", closeOnDesktop);
    if (!overlay.classList.contains("hidden")) closeMenu();
  }, { once: true });

  // Focus trap: keep Tab/Shift+Tab inside the overlay while it is open
  overlay.addEventListener("keydown", (e) => {
    if (e.key !== "Tab") return;
    const focusable = Array.from(
      overlay.querySelectorAll<HTMLElement>(focusableSelectors)
    ).filter((el) => !el.closest("[hidden]"));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
