---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useI18n } from "../i18n/astro";

const { t, path, href } = useI18n(Astro.url);

const navItems = [
  { label: t.nav.home, path: "/" },
  { label: t.nav.projects, path: "/projects" },
  { label: t.nav.about, path: "/about" },
  { label: t.nav.resume, path: "/resume" },
  { label: t.nav.contact, path: "/contact" },
].map((item) => ({ ...item, href: href(item.path) }));

const isActive = (itemPath: string) => {
  if (itemPath === "/") return path === "/";
  return path === itemPath || path.startsWith(itemPath + "/");
};
---

<header data-site-header class="border-b border-border bg-body">
  <div class="header-shell relative mx-auto flex w-full max-w-5xl items-center px-4 py-3 sm:py-4">
    <!-- Logo -->
    <a href={href("/")} class="inline-flex shrink-0 items-center" aria-label={t.nav.homeAria}>
      <picture>
        <source srcset="/mabux_logo_transparent.webp" type="image/webp" />
        <img src="/mabux_logo.png" alt="Mabux" width="80" height="80" class="brand-logo h-20 w-auto sm:h-20" loading="eager" decoding="async" />
      </picture>
    </a>

    <!-- Desktop: centered nav -->
    <nav aria-label={t.nav.mainLabel} class="desktop-nav absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-7 text-sm font-bold tracking-widest uppercase sm:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.path) ? "page" : undefined}
            class:list={[
              "rounded px-3 py-1.5 transition-colors",
              isActive(item.path)
                ? "bg-[#EFF93B] text-black"
                : "text-text-dark hover:text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right side -->
    <div class="ml-auto flex items-center gap-3">
      <!-- Language switcher: always visible, set apart from the menu items -->
      <div class="header-language">
        <LanguageSwitcher />
      </div>

      <!-- Mobile: hamburger button -->
      <button
        id="mobile-menu-open"
        type="button"
        class="mobile-menu-toggle min-h-11 min-w-11 p-2 text-text-dark sm:hidden"
        aria-label={t.nav.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu-overlay"
      >
        <svg class="h-6 w-6 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/>
        </svg>
      </button>
    </div>
  </div>
  <noscript>
    <nav class="mobile-fallback-nav" aria-label={t.nav.mainLabel}>
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.path) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </noscript>
</header>

<!-- Mobile: full-screen overlay menu -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-50 hidden flex-col bg-body"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-menu-title"
  aria-hidden="true"
>
  <!-- Close button -->
  <button
    id="mobile-menu-close"
    type="button"
    class="absolute right-5 top-5 text-2xl font-light text-text-dark"
    aria-label={t.nav.closeMenu}
  >
    ✕
  </button>

  <!-- Nav items -->
  <nav aria-label={t.nav.mainLabel} class="flex flex-1 flex-col items-center justify-center gap-4">
    <p id="mobile-menu-title" class="mb-6 text-xl font-black tracking-widest uppercase text-text-dark">{t.nav.menu}</p>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.path) ? "page" : undefined}
          class:list={[
            "w-64 rounded px-6 py-3 text-center text-sm font-bold tracking-widest uppercase transition-colors",
            isActive(item.path)
              ? "bg-[#EFF93B] text-black"
              : "text-text-dark hover:bg-light",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  [data-site-header] {
    padding-top: env(safe-area-inset-top, 0px);
  }

  .header-shell {
    padding-left: max(1rem, env(safe-area-inset-left, 0px));
    padding-right: max(1rem, env(safe-area-inset-right, 0px));
  }

  #mobile-menu-overlay {
    overflow-y: auto;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  #mobile-menu-overlay nav {
    min-height: 100%;
    flex-shrink: 0;
    padding: 4rem 1rem 2rem;
    justify-content: safe center;
  }

  #mobile-menu-close {
    z-index: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    top: max(1.25rem, env(safe-area-inset-top, 0px));
    right: max(1.25rem, env(safe-area-inset-right, 0px));
  }

  #mobile-menu-overlay nav > a {
    min-height: 2.75rem;
  }

  .mobile-fallback-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 1rem 1rem;
    font-weight: 700;
  }

  .mobile-fallback-nav a {
    padding: 0.5rem;
  }

  @media (min-width: 768px) {
    .mobile-fallback-nav {
      display: none;
    }
  }

  @media (min-width: 640px) and (max-width: 767px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }
  }

  @media (min-width: 640px) and (max-width: 820px) {
    .brand-logo {
      height: 4.25rem;
    }

    .desktop-nav {
      gap: 1.6rem;
      font-size: 0.8125rem;
    }

    .desktop-nav a {
      padding-left: 0.6rem;
      padding-right: 0.6rem;
    }
  }

  @media
    (orientation: landscape) and
    (min-width: 481px) and
    (max-width: 1023px) and
    (max-height: 480px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }

    .mobile-fallback-nav {
      display: flex;
    }
  }

  @media
    (orientation: landscape) and
    (min-width: 481px) and
    (max-width: 1023px) and
    (max-height: 480px) {
    .header-shell {
      padding-block: 0.25rem;
    }

    .brand-logo {
      height: 3rem;
    }

    .mobile-menu-toggle {
      padding: 0.375rem;
    }

    #mobile-menu-close {
      top: max(0.75rem, env(safe-area-inset-top, 0px));
      right: max(1rem, env(safe-area-inset-right, 0px));
    }

    #mobile-menu-overlay nav {
      gap: 0.75rem;
      padding: 2.5rem 1rem 0.75rem;
      overflow-y: auto;
    }

    #mobile-menu-title {
      margin-bottom: 0.75rem;
      font-size: 1rem;
      line-height: 1.25;
    }

    #mobile-menu-overlay nav > a {
      padding-block: 0.5rem;
      font-size: 0.75rem;
      line-height: 1.25;
    }
  }

  @media (min-width: 2560px) {
    .header-shell {
      max-width: 80rem;
      padding-block: 1.25rem;
    }

    .brand-logo {
      height: 6rem;
    }

    .desktop-nav {
      gap: 2.25rem;
      font-size: 1rem;
    }

  }

  @media (min-width: 3840px) {
    .header-shell {
      max-width: 112rem;
      padding-block: 1.5rem;
    }

    .brand-logo {
      height: 8rem;
    }

    .desktop-nav {
      gap: 3rem;
      font-size: 1.25rem;
    }

  }

  @media (scripting: none) {
    .mobile-menu-toggle {
      display: none;
    }
  }
</style>

<script>
  import { LANGUAGE_KEY, serializeLanguage } from "../utils/language-preference";
  import type { Locale } from "../i18n";

  // Remember an explicit language choice so the home-page redirect never overrides it.
  document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem(LANGUAGE_KEY, serializeLanguage(link.dataset.language as Locale));
      } catch {
        // Storage can be unavailable; the switch itself still works.
      }
    });
  });

  const openBtn = document.querySelector<HTMLButtonElement>("#mobile-menu-open");
  const closeBtn = document.querySelector<HTMLButtonElement>("#mobile-menu-close");
  const overlay = document.querySelector<HTMLElement>("#mobile-menu-overlay")!;

  const focusableSelectors = 'a[href], button:not([disabled])';
  let previousOverflow = "";
  let backgroundElements: { element: HTMLElement; wasInert: boolean }[] = [];

  const openMenu = () => {
    previousOverflow = document.body.style.overflow;
    backgroundElements = Array.from(document.querySelectorAll<HTMLElement>(
      "[data-site-header], main, [data-site-footer], #back-to-top, .skip-link",
    )).map((element) => ({ element, wasInert: element.inert }));
    backgroundElements.forEach(({ element }) => { element.inert = true; });
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    openBtn?.setAttribute("aria-expanded", "true");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    // Move focus to the close button when overlay opens
    closeBtn?.focus();
  };

  const closeMenu = () => {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    openBtn?.setAttribute("aria-expanded", "false");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = previousOverflow;
    backgroundElements.forEach(({ element, wasInert }) => { element.inert = wasInert; });
    backgroundElements = [];
    // Return focus to the hamburger button
    if (openBtn?.getClientRects().length) openBtn.focus();
    else document.querySelector<HTMLElement>(".desktop-nav [aria-current], [data-site-header] a")?.focus();
  };

  const closeOnDesktop = () => {
    if (!overlay.classList.contains("hidden") && !openBtn?.getClientRects().length) closeMenu();
  };

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  window.addEventListener("resize", closeOnDesktop);

  overlay?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Close on Escape key — named handler so it can be removed
  const onKeyDown = (e: KeyboardEvent) => {
    if (e.key === "Escape" && !overlay.classList.contains("hidden")) {
      closeMenu();
    }
  };

  document.addEventListener("keydown", onKeyDown);

  // Clean up before Astro View Transitions swap to avoid stacking listeners
  document.addEventListener("astro:before-swap", () => {
    document.removeEventListener("keydown", onKeyDown);
    window.removeEventListener("resize", closeOnDesktop);
    if (!overlay.classList.contains("hidden")) closeMenu();
  }, { once: true });

  // Focus trap: keep Tab/Shift+Tab inside the overlay while it is open
  overlay.addEventListener("keydown", (e) => {
    if (e.key !== "Tab") return;
    const focusable = Array.from(
      overlay.querySelectorAll<HTMLElement>(focusableSelectors)
    ).filter((el) => !el.closest("[hidden]"));
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
