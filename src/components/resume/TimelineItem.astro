---
import type { Experience } from "../../types/resume";
import { formatDuration, formatYearMonth, initials } from "../../utils/resume-dates";

interface Props {
  item: Experience;
  side: "left" | "right";
}

const { item, side } = Astro.props;
const isCurrent = item.end === null;
const isBreak = item.kind === "break";
const startYear = item.start.slice(0, 4);
const endYear = item.end ? item.end.slice(0, 4) : "Now";

const flags: Record<string, string> = {
  Estonia: "/flags/estonia.svg",
  Spain: "/flags/spain.svg",
  Australia: "/flags/australia.svg",
};
const country = item.location?.split(",").pop()?.trim();
const flag = country ? flags[country] : undefined;
---

<li class:list={["tl-item", `tl-${side}`, isBreak && "tl-break"]} data-timeline-item>
  <p class="tl-year" aria-hidden="true">
    <span class="tl-year-start">{startYear}</span>
    {endYear !== startYear && <span class="tl-year-end">– {endYear}</span>}
  </p>

  <span class:list={["tl-marker", item.logo && "has-logo"]} aria-hidden="true">
    {
      item.logo ? (
        <img src={item.logo} alt="" width="40" height="40" loading="lazy" />
      ) : isBreak ? (
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
      ) : (
        <span>{initials(item.company)}</span>
      )
    }
  </span>

  <article class="tl-card">
    <div class="tl-head">
      <h3>{item.role}</h3>
      {isCurrent && <span class="tl-badge">Current</span>}
      {isBreak && <span class="tl-badge tl-badge-break">Career break</span>}
    </div>
    <p class="tl-company">
      {item.company}
      {
        item.location && (
          <span class="tl-location">
            {" · "}
            {item.location}
            {flag && <img class="tl-flag" src={flag} alt="" width="18" height="12" loading="lazy" />}
          </span>
        )
      }
    </p>
    {item.industry && <p class="tl-industry">{item.industry}</p>}
    <p class="tl-dates">
      <time datetime={item.start}>{formatYearMonth(item.start)}</time>
      {" – "}
      {item.end ? <time datetime={item.end}>{formatYearMonth(item.end)}</time> : <span>Present</span>}
      <span class="tl-duration">· {formatDuration(item.start, item.end)}</span>
    </p>

    {
      item.highlights.length > 0 && (
        <ul class="tl-highlights">
          {item.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      )
    }
    {
      item.tags.length > 0 && (
        <ul class="tl-tags" aria-label="Skills and tools">
          {item.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</li>

<style>
  .tl-item {
    --marker-size: 2.5rem;
    --year-h: 2.5rem;
    --marker-top: calc(var(--year-h) + 1.5rem);
    --arrow-top: 1.5rem;
    --gutter: 3rem;
    position: relative;
    padding-left: calc(var(--marker-size) + 1.25rem);
  }

  /* Year label */
  .tl-year {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    height: var(--year-h);
    margin: 0;
    font-family: var(--font-secondary);
    line-height: 1;
    color: var(--color-text-dark);
    white-space: nowrap;
  }

  .tl-year-start {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tl-year-end {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-light);
  }

  /* Marker */
  .tl-marker {
    position: absolute;
    top: var(--marker-top);
    left: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: var(--marker-size);
    height: var(--marker-size);
    overflow: hidden;
    border: 2px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-body);
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-light);
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tl-marker img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .tl-marker.has-logo {
    background: #fff;
  }

  .tl-item.is-passed .tl-marker {
    border-color: var(--color-primary);
    color: var(--color-text-dark);
  }

  .tl-item.is-active .tl-marker {
    transform: scale(1.15);
    border-color: var(--color-primary);
    color: #000;
    box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.45);
  }

  /* Card */
  .tl-card {
    position: relative;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-light);
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .tl-card:hover,
  .tl-item.is-active .tl-card {
    border-color: #d6d6d6;
    box-shadow: 0 12px 30px -18px rgb(0 0 0 / 0.35);
  }

  /* Arrow pointing at the line */
  .tl-card::before {
    content: "";
    position: absolute;
    top: calc(var(--arrow-top) + var(--marker-size) / 2 - 0.5rem);
    left: -0.55rem;
    width: 1rem;
    height: 1rem;
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    background: inherit;
    transform: rotate(45deg);
    transition: border-color 0.3s ease;
  }

  .tl-card:hover::before,
  .tl-item.is-active .tl-card::before {
    border-color: #d6d6d6;
  }

  .tl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  h3 {
    font-size: 1.2rem;
  }

  .tl-badge {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: #eff93b;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #000;
  }

  .tl-company {
    margin: 0.25rem 0 0;
    font-weight: 600;
    color: var(--color-text-dark);
  }

  .tl-location {
    font-weight: 400;
    color: var(--color-text-light);
  }

  .tl-flag {
    display: inline-block;
    width: auto;
    height: 0.75rem;
    margin-left: 0.4rem;
    vertical-align: -0.05rem;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .tl-industry {
    margin: 0.1rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .tl-badge-break {
    border: 1px solid var(--color-border);
    background: var(--color-body);
    color: var(--color-text-light);
  }

  .tl-break .tl-card {
    border-style: dashed;
    border-color: #cfcfcf;
    background: var(--color-body);
  }

  .tl-break .tl-card::before {
    border-style: dashed;
    border-color: #cfcfcf;
  }

  .tl-dates {
    margin: 0.15rem 0 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .tl-duration {
    margin-left: 0.25rem;
  }

  .tl-highlights {
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .tl-highlights li::marker {
    color: var(--color-text-dark);
  }

  .tl-highlights li + li {
    margin-top: 0.2rem;
  }

  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tl-tags li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-body);
    font-size: 0.78rem;
    color: var(--color-text-dark);
  }

  /* Scroll reveal (only when JS can reveal it again) */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .tl-item .tl-card {
      opacity: 0;
      translate: 2rem 0;
      transition:
        opacity 0.6s ease,
        translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
        box-shadow 0.3s ease,
        border-color 0.3s ease;
    }

    .tl-item .tl-marker {
      scale: 0.4;
      opacity: 0;
      transition:
        scale 0.4s ease 0.15s,
        opacity 0.4s ease 0.15s,
        transform 0.3s ease,
        background-color 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
    }

    .tl-item.is-visible .tl-card {
      opacity: 1;
      translate: 0 0;
    }

    .tl-item .tl-year {
      opacity: 0;
      transition: opacity 0.6s ease 0.2s;
    }

    .tl-item.is-visible .tl-year {
      opacity: 1;
    }

    .tl-item.is-visible .tl-marker {
      scale: 1;
      opacity: 1;
    }
  }

  /* Desktop: alternate around a centred line */
  @media (min-width: 768px) {
    .tl-item {
      --marker-top: 1.5rem;
      width: 50%;
      padding-left: 0;
    }

    /* Year sits on the empty side of the line, level with the marker. */
    .tl-year {
      position: absolute;
      top: calc(var(--marker-top) + var(--marker-size) / 2 - var(--year-h) / 2);
      align-items: center;
    }

    .tl-left .tl-year {
      left: calc(100% + var(--marker-size) / 2 + 1.25rem);
    }

    .tl-right .tl-year {
      right: calc(100% + var(--marker-size) / 2 + 1.25rem);
    }

    .tl-year-start {
      font-size: 2.25rem;
    }

    .tl-marker {
      left: auto;
      right: calc(var(--marker-size) / -2);
    }

    .tl-left {
      padding-right: var(--gutter);
    }

    .tl-left .tl-card::before {
      left: auto;
      right: -0.55rem;
      border-bottom: 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
      border-right: 1px solid var(--color-border);
    }

    .tl-left:is(.is-active) .tl-card::before,
    .tl-left .tl-card:hover::before {
      border-color: #d6d6d6;
    }

    .tl-right {
      margin-left: 50%;
      padding-left: var(--gutter);
    }

    /* Stagger the alternating cards while keeping clear space above each year label. */
    .tl-item + .tl-item {
      margin-top: -0.5rem;
    }

    .tl-right .tl-marker {
      right: auto;
      left: calc(var(--marker-size) / -2);
    }

    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
      .tl-left .tl-card {
        translate: -2rem 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-marker,
    .tl-card,
    .tl-card::before {
      transition: none;
    }
  }
</style>
