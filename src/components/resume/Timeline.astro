---
import type { Experience } from "../../types/resume";
import TimelineItem from "./TimelineItem.astro";

interface Props {
  items: Experience[];
}

const { items } = Astro.props;
---

<section class="timeline-section" aria-labelledby="experience-heading">
  <h2 id="experience-heading">Experience</h2>
  <div class="timeline" data-timeline>
    <span class="tl-line" aria-hidden="true"><span class="tl-fill" data-timeline-fill></span></span>
    <ol class="tl-list">
      {items.map((item, index) => <TimelineItem item={item} side={index % 2 === 0 ? "left" : "right"} />)}
    </ol>
  </div>
</section>

<script>
  function initTimeline(timeline: HTMLElement) {
    const items = Array.from(timeline.querySelectorAll<HTMLElement>("[data-timeline-item]"));
    const fill = timeline.querySelector<HTMLElement>("[data-timeline-fill]");

    // Reveal on scroll
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
      );
      items.forEach((item) => observer.observe(item));
    } else {
      items.forEach((item) => item.classList.add("is-visible"));
    }

    // Line fill + passed/active markers, anchored to the viewport centre
    let ticking = false;
    const update = () => {
      ticking = false;
      const anchor = window.innerHeight * 0.5;
      const rect = timeline.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
      fill?.style.setProperty("--progress", progress.toFixed(4));

      let activeIndex = -1;
      items.forEach((item, index) => {
        const marker = item.querySelector(".tl-marker");
        const markerTop = (marker ?? item).getBoundingClientRect().top;
        const passed = markerTop <= anchor;
        item.classList.toggle("is-passed", passed);
        if (passed) activeIndex = index;
      });
      // At the very bottom of the page the last item may never cross the centre.
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atBottom && rect.bottom <= window.innerHeight) activeIndex = items.length - 1;
      items.forEach((item, index) => item.classList.toggle("is-active", index === activeIndex));
    };
    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    // Layout changes (fonts, resizing) change the timeline height.
    new ResizeObserver(requestUpdate).observe(timeline);
    update();
  }

  document.querySelectorAll<HTMLElement>("[data-timeline]").forEach(initTimeline);
</script>

<style>
  .timeline-section h2 {
    margin-bottom: 2.5rem;
    font-size: 1.75rem;
    text-align: center;
  }

  .timeline {
    --line-x: calc(1.25rem + 0.5rem);
    position: relative;
    /* Slack for the marker glow; clip hides cards while they slide in. */
    margin-inline: -0.5rem;
    padding-inline: 0.5rem;
    overflow-x: clip;
  }

  .tl-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--line-x);
    width: 3px;
    border-radius: 3px;
    background: var(--color-border);
    translate: -50% 0;
  }

  .tl-fill {
    --progress: 0;
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-primary);
    transform: scaleY(var(--progress));
    transform-origin: top;
  }

  .tl-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .timeline {
      --line-x: 50%;
      margin-inline: 0;
      padding-inline: 0;
    }

    .tl-list {
      gap: 1.5rem;
    }
  }

  @media (scripting: none) {
    .tl-fill {
      transform: none;
    }
  }
</style>
