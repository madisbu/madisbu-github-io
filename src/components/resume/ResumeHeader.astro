---
import type { ResumeData } from "../../types/resume";

type Props = Pick<ResumeData, "name" | "title" | "intro" | "resumeUrl">;

const { name, title, intro, resumeUrl } = Astro.props;
---

<header class="resume-header">
  <p class="eyebrow">Resume</p>
  <h1>{name}</h1>
  <p class="title">{title}</p>
  <p class="intro">{intro}</p>
  {
    resumeUrl && (
      <a
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-[#EFF93B] px-5 py-3 text-sm font-bold tracking-wide text-black shadow-sm transition-colors hover:bg-[#dbe52f]"
        href={resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
        View Resume
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    )
  }
</header>

<style>
  .resume-header {
    max-width: 42rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
  }

  .title {
    margin: 0.35rem 0 1rem;
    font-family: var(--font-secondary);
    font-size: 1.15rem;
    color: var(--color-text-dark);
  }

  .intro {
    margin: 0 0 1.75rem;
    color: var(--color-text);
  }
</style>
