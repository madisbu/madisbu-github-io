---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? "";
if (measurementId && !/^G-[A-Z0-9]+$/.test(measurementId)) {
  throw new Error("PUBLIC_GA_MEASUREMENT_ID must be a GA4 ID starting with G-.");
}
---

<div
  data-analytics-consent
  data-measurement-id={measurementId}
  data-production={String(import.meta.env.PROD)}
>
  <div class="privacy-controls" aria-label="Privacy controls">
    <a href={`${import.meta.env.BASE_URL}privacy/`}>Privacy</a>
    <span class="privacy-separator" aria-hidden="true"></span>
    <button type="button" data-cookie-settings aria-haspopup="dialog">Cookies</button>
  </div>
  <dialog aria-labelledby="consent-title" aria-describedby="consent-description">
    <p class="consent-eyebrow"><span aria-hidden="true"></span> OPTIONAL ANALYTICS</p>
    <h2 id="consent-title">Your privacy, your choice.</h2>
    <p id="consent-description">
      May I use Google Analytics to understand visits, engagement, resume downloads,
      and email-link clicks? No Analytics requests or cookies are sent until you accept.
      The site works the same if you reject.
    </p>
    <p class="consent-details">
      Your choice is saved for 180 days. Change your mind or withdraw consent anytime
      using Cookies.
    </p>
    <a class="consent-privacy-link" href={`${import.meta.env.BASE_URL}privacy/`}>Read the privacy notice <span aria-hidden="true">&rarr;</span></a>
    <p data-consent-status role="status" aria-live="polite"></p>
    <div class="consent-actions">
      <button type="button" data-consent-reject autofocus>Reject analytics</button>
      <button type="button" data-consent-accept>Accept analytics</button>
    </div>
  </dialog>
  <noscript><p class="no-script">Analytics is off because JavaScript is disabled.</p></noscript>
</div>

<script>
  import "../scripts/analytics";
</script>

<style>
  [data-analytics-consent] { display: contents; }

  .privacy-controls {
    position: fixed;
    bottom: calc(var(--mobile-footer-height, 68px) + env(safe-area-inset-bottom, 0px) + 0.5rem);
    left: max(0.5rem, env(safe-area-inset-left, 0px));
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    background: var(--color-body);
    color: var(--color-text-light);
    font-size: 0.75rem;
  }

  .privacy-controls a, .privacy-controls button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    border-radius: 0.25rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .privacy-controls a:hover, .privacy-controls button:hover {
    color: var(--color-text-dark);
    background: var(--color-light);
  }

  .privacy-controls a:focus-visible, .privacy-controls button:focus-visible {
    outline-offset: 1px;
  }

  .privacy-separator {
    width: 1px;
    height: 0.875rem;
    background: var(--color-border);
  }

  dialog {
    position: fixed;
    inset: 0;
    width: min(34rem, calc(100% - 2rem));
    max-height: calc(100svh - 2rem);
    margin: auto;
    overflow-y: auto;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-body);
    color: var(--color-text);
    box-shadow: 0 1.5rem 5rem #0003;
  }

  dialog::backdrop { background: #04040499; }
  .consent-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: var(--color-text-light);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .consent-eyebrow span {
    width: 1.5rem;
    height: 0.5rem;
    border-radius: 0.125rem;
    background: #eff93b;
  }
  h2 { font-size: clamp(1.75rem, 4vw, 2.25rem); }
  p { margin-top: 1rem; line-height: 1.65; }
  .consent-details { color: var(--color-text-light); font-size: 0.875rem; }
  .consent-privacy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    color: var(--color-text-dark);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  [data-consent-status] {
    padding: 0.75rem;
    border-radius: 0.375rem;
    background: var(--color-light);
    font-size: 0.875rem;
  }
  [data-consent-status]:empty { display: none; }
  .consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .consent-actions button {
    flex: 1 1 12rem;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-text-light);
    border-radius: 0.5rem;
    color: var(--color-text-dark);
    background: var(--color-body);
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .consent-actions button:hover { background: var(--color-light); }
  .consent-actions button:disabled { opacity: 0.5; cursor: not-allowed; }
  .no-script { padding: 0.5rem 1rem; font-size: 0.75rem; }

  @media (min-width: 640px) and (min-height: 481px), (min-width: 1024px) {
    .privacy-controls {
      position: static;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .privacy-controls a, .privacy-controls button {
      min-height: 2rem;
    }
  }
</style>
