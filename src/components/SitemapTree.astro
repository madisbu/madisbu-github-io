---
import type { CaseStudySitemapNode } from "../types/case-study";

export interface Props {
  node: CaseStudySitemapNode;
  /** Set on the top-level call to wrap the recursive tree in its container. */
  isRoot?: boolean;
}

const { node, isRoot = false } = Astro.props;
const hasChildren = Boolean(node.children && node.children.length > 0);
---

{isRoot ? (
  <div class="case-study-sitemap">
    <ul class="case-study-sitemap-tree">
      <li class:list={{ "has-children": hasChildren }}>
        <span class:list={{ "case-study-sitemap-node": true, "is-dashed": node.dashed }}>
          {node.label}
        </span>
        {hasChildren && (
          <ul>
            {node.children!.map((child) => <Astro.self node={child} />)}
          </ul>
        )}
      </li>
    </ul>
  </div>
) : (
  <li class:list={{ "has-children": hasChildren }}>
    <span class:list={{ "case-study-sitemap-node": true, "is-dashed": node.dashed }}>
      {node.label}
    </span>
    {hasChildren && (
      <ul>
        {node.children!.map((child) => <Astro.self node={child} />)}
      </ul>
    )}
  </li>
)}

<style>
  .case-study-sitemap {
    display: flex;
    width: 100%;
    justify-content: center;
    margin: 2.25rem 0 0;
    padding: 1.25rem 0.5rem;
    overflow-x: auto;
  }

  .case-study-sitemap-tree,
  .case-study-sitemap-tree ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study-sitemap-tree {
    flex: 0 0 max-content;
    margin: 0 auto;
  }

  .case-study-sitemap-tree ul {
    position: relative;
    padding-top: 2.6rem;
  }

  .case-study-sitemap-tree li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.6rem 0.9rem 0;
  }

  .case-study-sitemap-tree > li {
    padding-top: 0;
  }

  .case-study-sitemap-tree li::before,
  .case-study-sitemap-tree li::after {
    position: absolute;
    top: 0;
    right: 50%;
    width: 50%;
    height: 2.6rem;
    border-top: 1px solid var(--color-text-light);
    content: "";
  }

  .case-study-sitemap-tree li::after {
    right: auto;
    left: 50%;
    border-left: 1px solid var(--color-text-light);
  }

  .case-study-sitemap-tree > li::before,
  .case-study-sitemap-tree > li::after {
    display: none;
  }

  .case-study-sitemap-tree li:only-child::before {
    display: none;
  }

  .case-study-sitemap-tree li:only-child::after {
    right: auto;
    left: 50%;
    width: 0;
    border-top: 0 none;
    border-left: 1px solid var(--color-text-light);
  }

  .case-study-sitemap-tree li:first-child::before,
  .case-study-sitemap-tree li:last-child::after {
    border: 0 none;
  }

  .case-study-sitemap-tree li:last-child::before {
    border-right: 1px solid var(--color-text-light);
    border-radius: 0 0.5rem 0 0;
  }

  .case-study-sitemap-tree li:first-child::after {
    border-radius: 0.5rem 0 0 0;
  }

  .case-study-sitemap-tree li:only-child::after {
    border-left: 1px solid var(--color-text-light);
  }

  .case-study-sitemap-tree ul::before {
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 2.6rem;
    border-left: 1px solid var(--color-text-light);
    content: "";
  }

  .case-study-sitemap-node {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--case-study-accent);
    border-radius: 0.5rem;
    background: var(--color-light);
    color: var(--color-text-dark);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.3;
    white-space: nowrap;
  }

  .case-study-sitemap-tree > li > .case-study-sitemap-node {
    border-color: var(--case-study-accent);
    background: var(--case-study-accent);
    color: #fff;
  }

  .case-study-sitemap-node.is-dashed {
    border-style: dashed;
    background: var(--color-light);
    color: var(--color-text-dark);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .case-study-sitemap {
      margin-top: 1.75rem;
    }

    .case-study-sitemap-tree {
      transform: scale(0.92);
      transform-origin: center top;
    }

    .case-study-sitemap-node {
      padding: 0.7rem 1.1rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 1023px) {
    .case-study-sitemap {
      justify-content: flex-start;
      overflow-x: auto;
    }

    .case-study-sitemap-tree {
      margin-right: 0;
      margin-left: 0;
      transform-origin: top left;
    }
  }

  @media (max-width: 767px) {
    .case-study-sitemap {
      padding: 0.75rem 0.25rem 0;
    }

    .case-study-sitemap-tree {
      transform: scale(0.92);
    }

    .case-study-sitemap-node {
      font-size: 0.9rem;
    }
  }
</style>
