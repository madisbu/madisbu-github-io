---
const copyrightText = `Copyright © Madis Burmeister ${new Date().getFullYear()}`;

const desktopSocials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/madis-burmeister/",
    icon: "linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/madisbu",
    icon: "github",
  },
];

const mobileQuickLinks = [
  {
    label: "WhatsApp",
    href: "https://api.whatsapp.com/send?phone=3725130102",
    icon: "whatsapp",
  },
  {
    label: "Email",
    href: "mailto:madis.burmeister@mabux.me",
    icon: "email",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/madis-burmeister/",
    icon: "linkedin",
  },
];
---

<footer data-site-footer class="border-t border-border bg-body">
  <div class="desktop-footer-shell mx-auto hidden w-full max-w-5xl items-center px-4 py-6 sm:grid sm:grid-cols-3">
    <p class="desktop-footer-copy text-sm font-[550] text-text-dark">{copyrightText}</p>

    <nav aria-label="Desktop social links" class="justify-self-end sm:col-start-3">
      <ul class="flex items-center gap-4">
        {
          desktopSocials.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                class="desktop-footer-icon inline-flex h-8 w-8 items-center justify-center rounded bg-dark text-white transition-opacity hover:opacity-85"
              >
                {item.icon === "linkedin" ? (
                  <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                    <path d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6S0 4.88 0 3.5 1.12 1 2.48 1s2.5 1.12 2.5 2.5ZM.5 8h4V23h-4V8Zm7 0h3.8v2h.1c.53-1 1.84-2 3.8-2 4.06 0 4.8 2.67 4.8 6.15V23h-4v-7.5c0-1.8-.03-4.1-2.5-4.1-2.5 0-2.9 1.95-2.9 3.97V23h-4V8Z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52 0-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

  </div>

  <div data-mobile-quick-links class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-body sm:hidden">
    <nav aria-label="Mobile quick links" class="mx-auto grid w-full max-w-5xl grid-cols-3 px-4 py-2">
      {
        mobileQuickLinks.map((item) => (
          <a
            href={item.href}
            target={item.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={item.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            class="flex flex-col items-center justify-center gap-1 py-1 text-text-dark"
          >
            {item.icon === "whatsapp" ? (
              <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
                <path d="M20.52 3.48A11.8 11.8 0 0 0 12.03 0C5.52 0 .22 5.3.22 11.8c0 2.08.54 4.11 1.56 5.9L0 24l6.5-1.7a11.8 11.8 0 0 0 5.53 1.41h.01c6.5 0 11.8-5.3 11.8-11.8 0-3.15-1.23-6.1-3.32-8.43ZM12.04 21.7a9.83 9.83 0 0 1-5.01-1.37l-.36-.22-3.86 1.01 1.03-3.76-.24-.39a9.79 9.79 0 0 1-1.5-5.2c0-5.42 4.42-9.83 9.85-9.83 2.62 0 5.07 1.02 6.92 2.88a9.76 9.76 0 0 1 2.88 6.93c0 5.43-4.42 9.85-9.83 9.85Zm5.4-7.35c-.3-.15-1.76-.87-2.03-.97-.27-.1-.46-.15-.66.15-.2.3-.76.97-.93 1.17-.17.2-.34.22-.63.07-.3-.15-1.24-.46-2.36-1.48a8.78 8.78 0 0 1-1.63-2.03c-.17-.29-.02-.45.13-.6.13-.13.3-.34.44-.5.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.66-1.6-.9-2.2-.24-.57-.48-.5-.66-.51h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.06 2.9 1.2 3.1c.15.2 2.08 3.17 5.03 4.44.7.3 1.25.48 1.68.61.7.22 1.34.19 1.84.12.56-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.08-.12-.27-.2-.56-.35Z" />
              </svg>
            ) : item.icon === "email" ? (
              <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
                <path d="M20 4H4C2.9 4 2 4.9 2 6v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
                <path d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6S0 4.88 0 3.5 1.12 1 2.48 1s2.5 1.12 2.5 2.5ZM.5 8h4V23h-4V8Zm7 0h3.8v2h.1c.53-1 1.84-2 3.8-2 4.06 0 4.8 2.67 4.8 6.15V23h-4v-7.5c0-1.8-.03-4.1-2.5-4.1-2.5 0-2.9 1.95-2.9 3.97V23h-4V8Z" />
              </svg>
            )}
            <span class="text-xs font-medium text-text-light">{item.label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  @media (min-width: 2560px) {
    .desktop-footer-shell {
      max-width: 80rem;
      padding-block: 2rem;
    }

    .desktop-footer-copy {
      font-size: 1rem;
    }

    .desktop-footer-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (min-width: 3840px) {
    .desktop-footer-shell {
      max-width: 112rem;
      padding-block: 2.5rem;
    }

    .desktop-footer-copy {
      font-size: 1.25rem;
    }

    .desktop-footer-icon {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
