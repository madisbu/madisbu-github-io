---
import type { CaseStudyMedia, CaseStudyStep } from "../types/case-study";

interface Props {
  id: string;
  steps: CaseStudyStep[];
  media: CaseStudyMedia[];
}

const { id, steps, media } = Astro.props;
if (steps.length !== media.length || steps.length === 0) {
  throw new Error(`Media tabs in "${id}" require one image per step.`);
}
---

<div class="media-tabs" data-media-tabs>
  <div class="media-tabs-list" role="tablist" aria-label="Order journey">
    {steps.map((step, index) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${index}`}
        aria-controls={`${id}-panel-${index}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
      >
        <span class="media-tabs-number">{String(index + 1).padStart(2, "0")}</span>
        <span class="media-tabs-title">{step.title}</span>
        <span class="media-tabs-description">{step.description}</span>
      </button>
    ))}
  </div>
  {media.map((image, index) => (
    <div
      role="tabpanel"
      id={`${id}-panel-${index}`}
      aria-labelledby={`${id}-tab-${index}`}
      hidden={index !== 0}
      tabindex="0"
    >
      <figure>
        <button
          class="media-tabs-zoom"
          type="button"
          data-case-study-media-trigger
          data-zoom-src={image.zoomSrc ?? image.src}
          aria-label={`Enlarge image: ${image.alt}`}
        >
          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
        </button>
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    </div>
  ))}
</div>

<script>
  const initMediaTabs = () => {
    document.querySelectorAll<HTMLElement>("[data-media-tabs]").forEach((root) => {
      if (root.dataset.initialized) return;
      root.dataset.initialized = "true";
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const selectTab = (index: number) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute("aria-selected", String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          panels[i].hidden = i !== index;
        });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectTab(index));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          selectTab(next);
          tabs[next].focus();
        });
      });
    });
  };
  initMediaTabs();
  document.addEventListener("astro:page-load", initMediaTabs);
</script>

<style>
  .media-tabs { margin-top: 2rem; }
  .media-tabs-list { display: grid; gap: 0.75rem; }
  [role="tab"] {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-align: left;
    cursor: pointer;
    background: transparent;
  }
  [role="tab"]:hover { background: var(--color-light); }
  [role="tab"][aria-selected="true"] {
    border-color: var(--case-study-accent);
    background: color-mix(in srgb, var(--case-study-accent) 6%, var(--color-body));
  }
  [role="tab"]:focus-visible, [role="tabpanel"]:focus-visible, .media-tabs-zoom:focus-visible {
    outline: 2px solid var(--case-study-accent);
    outline-offset: 4px;
  }
  .media-tabs-number { color: var(--case-study-accent); font-size: 0.8rem; font-weight: 700; }
  .media-tabs-title { color: var(--color-text-dark); font-size: 1rem; font-weight: 700; }
  .media-tabs-description { color: var(--color-text); font-size: 0.9rem; line-height: 1.65; }
  [role="tabpanel"] { margin-top: 2rem; }
  [role="tabpanel"][hidden] { display: none; }
  figure { margin: 0; }
  .media-tabs-zoom { display: block; width: 100%; cursor: zoom-in; border-radius: 1rem; overflow: hidden; }
  img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 0.9rem; color: var(--color-text-light); font-size: 0.85rem; line-height: 1.65; }
  @media (min-width: 768px) {
    .media-tabs-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
